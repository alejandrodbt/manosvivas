# =============================================================================
# Manos Vivas — variables de entorno
#
# Plantilla SIN valores: este archivo sí se versiona. Los valores reales van
# en el panel de Vercel (Settings > Environment Variables), o en un archivo
# .env local que git ignora.
#
# Después de cambiar una variable en Vercel hay que volver a desplegar: las
# variables no se aplican a despliegues ya hechos.
# =============================================================================


# ---- Mercado Pago -----------------------------------------------------------
# Panel: mercadopago.cl/settings/account/credentials
#
# Anota acá a qué aplicación de Mercado Pago corresponden estas credenciales,
# porque el secret del webhook se configura por aplicación:
#   Aplicación: ____________________  (application_id: ______________)

# Access Token. SECRETO: nunca en el frontend ni en el repositorio.
# Empieza con APP_USR- en producción y con TEST- en modo prueba.
# Lo usan: crear-preferencia, procesar-pago, webhook-pago, crear-plan-manada
MERCADOPAGO_ACCESS_TOKEN=

# Firma de los webhooks. Se genera al registrar la URL de notificaciones en
# el panel de Mercado Pago. Si queda vacía, webhook-pago.py ACEPTA las
# notificaciones sin validar la firma: sirve para probar, no para producción.
# Lo usa: webhook-pago
MERCADOPAGO_WEBHOOK_SECRET=

# La Public Key NO va acá: es pública y vive en js/booking.js (CONFIG),
# porque el navegador la necesita para tokenizar la tarjeta.


# ---- Supabase ---------------------------------------------------------------
# Panel: Project Settings > API

# URL del proyecto, ej. https://xxxxxxxx.supabase.co
# Lo usan: crear-preferencia, procesar-pago, webhook-pago
SUPABASE_URL=

# Secret key (service_role). SECRETO: ignora las políticas RLS por completo,
# así que solo va en el backend, nunca en el frontend.
# Necesita estos permisos de tabla:
#   grant select on public.catalogo     to service_role;
#   grant select on public.complementos to service_role;
#   grant select, insert, update, delete on public.reservas to service_role;
# Lo usan: crear-preferencia, procesar-pago, webhook-pago
SUPABASE_SERVICE_ROLE_KEY=


# ---- Google Calendar --------------------------------------------------------

# Contenido COMPLETO del JSON de la cuenta de servicio, en una sola línea.
# SECRETO. El archivo .json no se versiona (ver .gitignore).
# El calendario debe estar compartido con el correo de la cuenta de servicio,
# con permiso para hacer cambios en los eventos.
# Lo usan: disponibilidad, webhook-pago
GOOGLE_SERVICE_ACCOUNT_JSON=

# Opcional. Por defecto: manosvivascl@gmail.com
# GOOGLE_CALENDAR_ID=


# ---- Brevo (newsletter) -----------------------------------------------------

# API key de la aplicación "manosvivas-web". SECRETO.
# Lo usa: newsletter
BREVO_API_KEY=

# Opcional. Id numérico de la lista de contactos. Si queda vacío, el contacto
# se crea sin asignarlo a ninguna lista.
# BREVO_LIST_ID=


# ---- Sitio ------------------------------------------------------------------

# Dominio público. Define las back_urls a las que Mercado Pago devuelve al
# cliente después de pagar, y la notification_url del webhook.
# Opcional. Por defecto: https://manosvivas.cl
# SITE_URL=https://manosvivas.cl

# Rango horario que ofrece el calendario de reservas, en hora de Chile.
# Opcional. Por defecto: de 9 a 20. Todavía no distingue días de la semana.
# DISPONIBILIDAD_HORA_INICIO=9
# DISPONIBILIDAD_HORA_FIN=20
